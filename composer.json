{
    "name": "sergiodlopes/omnipay-eupago",
    "type": "library",
    "description": "euPago integration in omnipay",
    "keywords": [
        "eupago",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
		"multibanco",
        "mbway",
        "pagaqui",
        "payshop"
    ],
    "homepage": "https://github.com/sergiodlopes/omnipay-eupago",
    "license": "MIT",
    "authors": [
        {
            "name": "Sérgio Dinis Lopes",
            "email": "contacto@sergiodinislopes.pt"
        }
    ],
    "autoload": {
        "psr-4": { "Omnipay\\Eupago\\" : "src/" }
    },
    "require": {
        "php": ">=7.2",
        "omnipay/common": "^3.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.4"
    },
    "extra": {
        "branch-alias": {
            "dev-3.0": "3.0-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
